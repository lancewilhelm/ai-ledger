<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-ledger.collector</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ai-ledger-collector</string>
        <string>sync</string>
    </array>
    <key>StartInterval</key>
    <integer>180</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/ai-ledger-collector.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ai-ledger-collector.err.log</string>
</dict>
</plist>
